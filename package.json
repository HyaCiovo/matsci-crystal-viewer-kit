{
  "name": "@gnosys/matsci-crystal-viewer-kit",
  "version": "0.1.4",
  "description": "Extracted crystal structure viewer components from matsci-ui",
  "author": "hyacinth",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0",
    "npm": ">=10.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "https://packages.aliyun.com/6549daf63aaed849b035d118/npm/gnosys-release/"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && rollup -c && node scripts/prepare-style-assets.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "clean": "node scripts/clean-dist.mjs",
    "prepack": "npm run build",
    "release": "node scripts/release.mjs release",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish",
    "release:changelog": "node scripts/release.mjs changelog",
    "release:pack": "npm pack --dry-run --cache ./.npm-cache",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "three": "^0.163.0"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "d3-color": "^3.1.0",
    "lucide-react": "^0.539.0",
    "svgtodatauri": "^0.0.0",
    "use-resize-observer": "^9.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-swc": "^0.3.1",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-color": "^3.1.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.4",
    "@types/three": "^0.163.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^24.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rollup": "^4.60.1",
    "rollup-plugin-dts": "^6.4.0",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "^10.4.6",
    "three": "^0.163.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.4"
  }
}
